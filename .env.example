# Nabe self-contained development stack.
# Copy to .env for local use. Never commit .env.

TZ=Europe/Berlin

# Bind addresses are loopback by default so the dev stack is not public.
NABE_WEB_BIND=127.0.0.1:5173
NABE_API_BIND=127.0.0.1:8080
ADGUARD_DEBUG_BIND=127.0.0.1:3000
DNS_DOT_BIND=127.0.0.1:853
DNS_DOH_BIND=127.0.0.1:4443

# Nabe
NABE_PUBLIC_URL=http://localhost:5173
NABE_API_URL=http://nabe-api:8080
NABE_API_HOST=0.0.0.0
NABE_API_PORT=8080

# PostgreSQL
POSTGRES_DB=nabe
POSTGRES_USER=nabe
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://nabe:change-me-local-only@nabe-postgres:5432/nabe

# AdGuard Home is only reachable by Nabe over the Compose network by default.
ADGUARD_BASE_URL=http://dns-adguard:3000
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# Zitadel / OIDC placeholders
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional Newt profile. Only needed when testing Pangolin/Newt routing.
PANGOLIN_ENDPOINT=
NEWT_ID=
NEWT_SECRET=
